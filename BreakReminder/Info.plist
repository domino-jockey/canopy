<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- canopy://focus-on and focus-off, opened by Shortcuts automations. breakreminder:// is the name from before the rename. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.jammyjellyfish.BreakReminder</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>canopy</string>
				<string>breakreminder</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
